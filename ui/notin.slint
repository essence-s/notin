// La ventana es el botón: reposo y grabando (como en dicta).
// Estados visibles: gris en reposo, rojo grabando (criterio 2 de la historia #1).
export component AppWindow inherits Window {
    title: "notin";
    width: 200px;
    height: 72px;

    // El estado lo manda el Rust al cambiar de sesión.
    in-out property <bool> recording: false;
    // La ventana avisa al Rust cuando se pulsa.
    callback toggle();

    Rectangle {
        border-radius: 14px;
        background: root.recording ? #c0392b : #1d2021;

        Text {
            width: 100%;
            height: 100%;
            text: root.recording ? "● grabando" : "notin";
            color: #ffffff;
            font-size: root.recording ? 14px : 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // La ventana entera es el botón.
        TouchArea {
            clicked => { root.toggle(); }
        }
    }
}
