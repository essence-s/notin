export component ConfigurationWindow inherits Window {
    title: "notin - configuracion";

    in-out property <bool> models_installed: false;
    in-out property <string> model_path: "";

    callback download_models();
    callback open_float_window();

    Rectangle {
        background: #1d2021;
        width: parent.width;
        height: parent.height;

        Rectangle {
            background: #2a2a2a;
            x: ((parent.width - 320px) / 2px) * 1px;
            y: ((parent.height - 220px) / 2px) * 1px;
            width: 320px;
            height: 220px;
            border-radius: 12px;

            Text {
                text: "Configuración de notin";
                color: #ffffff;
                font-size: 18px;
                horizontal-alignment: center;
                y: 18px;
                width: parent.width;
            }

            Text {
                text: root.models_installed ? "Modelo instalado: Nemo CTC (español)" : "Modelo no instalado";
                color: #ffffff;
                font-size: 14px;
                horizontal-alignment: center;
                y: 48px;
                width: parent.width;
            }

            Text {
                text: root.model_path;
                color: #aaaaaa;
                font-size: 11px;
                horizontal-alignment: center;
                y: 68px;
                width: parent.width;
            }

            Rectangle {
                background: root.models_installed ? #555555 : #c0392b;
                x: 20px;
                y: 100px;
                width: 280px;
                height: 32px;
                border-radius: 8px;

                TouchArea {
                    clicked => { root.download_models(); }
                }

                Text {
                    text: root.models_installed ? "Modelo instalado" : "Descargar modelo";
                    color: #ffffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            Rectangle {
                background: #4a4a4a;
                x: 20px;
                y: 138px;
                width: 280px;
                height: 32px;
                border-radius: 8px;

                TouchArea {
                    clicked => { root.open_float_window(); }
                }

                Text {
                    text: "Abrir ventana flotante";
                    color: #ffffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }
}

export component NotinWindow inherits Window {
    title: "notin";
    width: 200px;
    height: 72px;

    in-out property <bool> recording: false;
    callback toggle();
    callback open_configuration();

    Rectangle {
        border-radius: 14px;
        background: root.recording ? #c0392b : #1d2021;

        Text {
            width: 100%;
            height: 100%;
            text: root.recording ? "● grabando" : "notin";
            color: #ffffff;
            font-size: root.recording ? 14px : 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.toggle(); }
        }

        // Botón de tuerca: abre/oculta la ventana de configuración.
        Rectangle {
            x: 160px;
            y: 20px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #2a2a2a;

            Text {
                text: "⚙";
                color: #ffffff;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }

            TouchArea {
                clicked => { root.open_configuration(); }
            }
        }
    }
}
